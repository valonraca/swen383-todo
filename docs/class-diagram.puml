@startuml ClassDiagram
allowmixing
title Week 6 — current Todo App
skinparam classAttributeIconSize 0
hide empty members

package "UI coordination" {
  class TodoController {
    + todoService
    + todoRenderer: TodoRenderer
    + TodoController(todoService, todoRenderer)
    + start()
    + addTask(description)
    + addUrgentTask(description)
    + toggleTask(id)
    + deleteTask(id)
  }
  class TodoRenderer {
    + container: HTMLElement
    + actions: Object
    + TodoRenderer(containerId)
    + bindActions(actions)
    + renderPendingRows(service)
    + renderCompletedRows(service)
    + render(service, justAddedId)
  }
}

package "Builder and task domain" {
  class TodoService {
    + storage
    + tasks: Array
    + TodoService(storage)
    + addTask(description)
    + addUrgentTask(description)
    + validate(description)
    + store(task)
    + toggleComplete(id)
    + deleteTask(id)
    + getWorkloadSummary()
  }
  class Task <<Product>> {
    + id: number
    + desc: String
    + completed: boolean
    + priority: String
    + createdAt: String
    + Task(builder)
  }
  class TaskBuilder <<Builder>> {
    + desc: String
    + priority: String
    + TaskBuilder(desc)
    + setPriority(priority): TaskBuilder
    + addLabel(label): TaskBuilder
    + build(): Task
  }
}

package "Factory Method storage" {
  abstract class StorageHandler <<Product>> {
    {abstract} + load()
    {abstract} + save(tasks)
  }
  class LocalStorageHandler <<ConcreteProduct>> {
    + load()
    + save(tasks)
  }
  class InMemoryStorageHandler <<ConcreteProduct>> {
    + tasks: Array
    + load()
    + save(tasks)
  }
  abstract class StorageFactory <<Creator>> {
    + createService(): TodoService
    {abstract} + createStorage(): StorageHandler
  }
  class LocalStorageFactory <<ConcreteCreator>> {
    + createStorage(): LocalStorageHandler
  }
  class InMemoryStorageFactory <<ConcreteCreator>> {
    + createStorage(): InMemoryStorageHandler
  }
}

rectangle "main.js" as Main <<composition root>>
rectangle "onToggle(id) / onDelete(id)" as Actions <<bound callbacks>>
rectangle "buildTaskRow(...)" as Rows <<free function>>
rectangle "Task container / document" as DOM <<browser API>>
rectangle "localStorage" as BrowserStorage <<browser API>>

LocalStorageHandler --|> StorageHandler
InMemoryStorageHandler --|> StorageHandler
LocalStorageFactory --|> StorageFactory
InMemoryStorageFactory --|> StorageFactory
StorageFactory ..> TodoService : createService() constructs
StorageFactory ..> StorageHandler : createStorage() returns
LocalStorageFactory ..> LocalStorageHandler : creates
InMemoryStorageFactory ..> InMemoryStorageHandler : creates
LocalStorageHandler ..> BrowserStorage : reads / writes todo-tasks
TodoService --> StorageHandler : injected load/save backend
TodoService ..> TaskBuilder : normal / urgent recipes
TaskBuilder ..> Task : build() creates
TodoService --> "0..*" Task : stores task-shaped records
Main ..> LocalStorageFactory : selects default creator
Main ..> TodoRenderer : creates
Main ..> TodoController : injects service and renderer
TodoController --> TodoRenderer : holds injected reference
TodoController ..> Actions : supplies bound functions
TodoRenderer --> Actions : stores and invokes
Actions ..> TodoController : toggleTask / deleteTask
TodoRenderer --> DOM : references existing elements
TodoRenderer ..> Rows : builds markup

note bottom of Task
  New records are Task products. JSON reloads produce
  plain records with the same persisted fields.
end note
note bottom of StorageHandler
  Base methods throw until overridden.
  TodoService only requires the load/save shape.
end note
TodoController --> TodoService : injected service
TodoRenderer ..> TodoService : reads tasks and summary
@enduml
